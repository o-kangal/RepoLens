# Names only. Copy to .env and set the values there; never commit them.
REPOLENS_DEBUG=
# For running the backend on the host: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DB,
# matching the values below. Docker Compose builds its own URL from them and ignores this one.
REPOLENS_DATABASE_URL=

# Embeddings. The model defaults to voyage-code-4; changing it requires re-indexing.
REPOLENS_EMBEDDING_MODEL=
REPOLENS_VOYAGE_API_KEY=

# Answer generation. Provider: anthropic (default), openai or azure_openai.
REPOLENS_LLM_PROVIDER=
# Defaults to claude-opus-5-5 for anthropic; required for openai, and the deployment name on Azure.
REPOLENS_LLM_MODEL=
# Optional further models the UI may choose, comma-separated, e.g. claude-sonnet-5-5,claude-haiku-5-5.
REPOLENS_LLM_MODELS=
# Anthropic only: retry safety refusals on a fallback model. Set false for models without one.
REPOLENS_LLM_REFUSAL_FALLBACK=
REPOLENS_ANTHROPIC_API_KEY=
REPOLENS_OPENAI_API_KEY=
REPOLENS_AZURE_OPENAI_ENDPOINT=
REPOLENS_AZURE_OPENAI_API_KEY=
REPOLENS_AZURE_OPENAI_API_VERSION=

# Docker Compose database. All three are required. Keep the password URL-safe (letters, digits,
# - . _ ~), since Compose puts it into the database URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Docker Compose host ports, bound to 127.0.0.1 only. Defaults: 5432, 8000 and 8080.
POSTGRES_PORT=
REPOLENS_API_PORT=
REPOLENS_WEB_PORT=
